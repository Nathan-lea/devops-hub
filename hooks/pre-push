#!/usr/bin/env bash
# ============================================================
# pre-push 钩子：推送前二次守卫
# 1. 复跑 pre-commit 对全量待推送文件的校验（防止绕过/陈旧文件）
# 2. 推送摘要提示（分支/提交数/文件数）
# 用法：pre-push 在 git push 时自动触发
# ============================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 读取标准输入：<local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # 仅处理 main 分支（按需扩展）
  branch="${remote_ref#refs/heads/}"

  # 计算待推送的提交数与文件变更
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 新分支：列出本地所有提交
    range="$local_sha"
    commit_count="$(git rev-list --count "$local_sha" 2>/dev/null || echo 0)"
  else
    range="${remote_sha}..${local_sha}"
    commit_count="$(git rev-list --count "$range" 2>/dev/null || echo 0)"
  fi
  file_count="$(git diff --name-only "$range" 2>/dev/null | wc -l)"

  printf "\033[36m[pre-push]\033[0m 即将推送分支 '%s'：%s 个提交，涉及 %s 个文件\n" \
    "$branch" "$commit_count" "$file_count" >&2

  # 对本次推送涉及的文件复跑 pre-commit 校验
  if [ "$commit_count" -gt 0 ]; then
    printf "\033[36m[pre-push]\033[0m 复跑提交前校验...\n" >&2
    # 将待推送文件加入暂存区校验逻辑：用 pre-commit 脚本对工作区当前状态检查
    if ! bash "$REPO_ROOT/hooks/pre-commit" >/dev/null 2>&1; then
      printf "\033[31m[FAIL]\033[0m pre-commit 校验未通过，推送已中止。请运行 pre-commit 修复或 git push --no-verify 跳过（不推荐）\n" >&2
      exit 1
    fi
    printf "\033[36m[pre-push]\033[0m 校验通过，允许推送 ✓\n" >&2
  fi
done

exit 0
